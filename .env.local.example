# Get your key from build.nvidia.com -> profile -> API Keys.
# Make sure "AI Foundation Models and Endpoints" is enabled for the key.
NVIDIA_API_KEY=nvapi-your-key-here

# AWS credentials for uploading local files to S3.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=your-bucket-name

# Optional. Only needed if you also want a stable public URL for the uploaded object.
# The app now sends NVIDIA a pre-signed HTTPS URL automatically.
AWS_S3_PUBLIC_URL=https://your-bucket.s3.us-east-1.amazonaws.com
